{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/tracker.schema.json",
  "title": "Portable Milestone Tracker — line schema",
  "description": "Each line of a .jsonl tracker file must validate against exactly one of these record shapes (discriminated by _type).",
  "oneOf": [
    { "$ref": "#/$defs/metaRecord" },
    { "$ref": "#/$defs/issueRecord" }
  ],
  "$defs": {
    "metaRecord": {
      "type": "object",
      "required": ["_type", "format_version", "doc_id", "field_defs", "link_types", "state_hash", "history_hashes"],
      "additionalProperties": false,
      "properties": {
        "_type": { "const": "meta" },
        "format_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "doc_id": { "type": "string" },
        "title": { "type": "string" },
        "field_defs": {
          "type": "array",
          "items": { "$ref": "#/$defs/fieldDef" }
        },
        "link_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hidden_field_keys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Field keys hidden from the table (but not deleted — their data and def are untouched). Missing/absent is treated as an empty list for older files."
        },
        "state_hash": { "type": "string" },
        "history_hashes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "fieldDef": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "type": { "enum": ["text", "enum", "multiselect"], "description": "'reference' was removed — any 'text' field now auto-detects links/references at display time." },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "description": "Also the stored field value — renaming an option does not migrate existing issues' stored values." },
              "color": { "enum": ["red", "amber", "green", "blue", "teal", "purple", "pink", "gray"] }
            }
          },
          "description": "Required when type is enum or multiselect. Order sets sort order for enum/multiselect sort. Plain-string options from older files are migrated to {label, color: 'gray'} on load."
        }
      }
    },

    "issueRecord": {
      "type": "object",
      "required": ["_type", "id", "source", "fields", "links", "events"],
      "additionalProperties": false,
      "properties": {
        "_type": { "const": "issue" },
        "id": { "type": "string" },
        "source": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/source" }
          ]
        },
        "fields": {
          "type": "object",
          "description": "Materialized current value per field key — a cache derived by replaying events. Ground truth is events."
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },

    "source": {
      "type": "object",
      "required": ["system", "synced_at", "cached"],
      "additionalProperties": false,
      "properties": {
        "system": { "enum": ["github", "jira"] },
        "repo": { "type": "string", "description": "GitHub owner/repo, e.g. 'org/repo'." },
        "number": { "type": "integer", "description": "GitHub issue number." },
        "key": { "type": "string", "description": "Jira issue key, e.g. 'PROJ-123'." },
        "url": { "type": "string" },
        "synced_at": { "type": ["string", "null"] },
        "cached": {
          "type": "object",
          "description": "Read-only mirror of source fields. Overwritten wholesale on refresh, never merged."
        }
      }
    },

    "link": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "Must be one of the document's link_types." },
        "target": { "type": "string", "description": "id of another issue record in this document." },
        "status": { "type": "string", "description": "Optional per-link status, e.g. 'chosen', 'proposed'." }
      }
    },

    "event": {
      "type": "object",
      "required": ["id", "actor", "lamport", "ts", "op"],
      "properties": {
        "id": { "type": "string" },
        "actor": { "type": "string" },
        "lamport": { "type": "integer", "minimum": 0 },
        "ts": { "type": "string", "format": "date-time" },
        "op": { "enum": ["create", "set_field", "comment", "link_add", "link_remove"] }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "set_field" } } },
          "then": { "required": ["field", "value"] }
        },
        {
          "if": { "properties": { "op": { "const": "comment" } } },
          "then": { "required": ["body"] }
        },
        {
          "if": { "properties": { "op": { "enum": ["link_add", "link_remove"] } } },
          "then": { "required": ["link"] }
        }
      ]
    }
  }
}
