{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wigwag",
  "version": "0.1.0",
  "identifier": "uk.lant.wigwag",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "node src-tauri/copy-dist.js",
    "beforeDevCommand": "node src-tauri/copy-dist.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wigwag",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMjBFMEUwMzA3NkE5QzIKUldUQ3FYWXc0T0Fnb29qcFFkUzBnY0RTdXVZTFFVT0NyR3hyalU1TVd1ZnJDRlcyalR5bVRnMzAK",
      "endpoints": [
        "https://github.com/lampholder/wigwag/releases/latest/download/latest.json"
      ]
    }
  }
}
